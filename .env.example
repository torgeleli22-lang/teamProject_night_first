# ─────────────────────────────────────────────────────────────
# API (Lambda / 로컬: npm run api) 설정 — 로컬은 이 파일을 .env 로 복사
# Lambda 에서는 같은 이름으로 '환경 변수'에 넣는다 (비밀 값은 GitHub 에 올리지 않기)
# ─────────────────────────────────────────────────────────────

# AI 동작 모드: live(실제 Claude) | mock(흉내 낸 AI 응답, UI/UX 확인용) | off(AI 없이 규칙 채점·저장된 해설만)
AI_MODE=mock
# Claude API 키 (live 모드)
ANTHROPIC_API_KEY=
# 작업 난이도별 모델 (비용 관리)
# CLAUDE_MODEL_FAST=claude-haiku-5-5
# CLAUDE_MODEL_SMART=claude-opus-5-5
# 하루 최대 AI 콘텐츠 생성 횟수, 월 예산(USD) — 예산을 넘으면 모든 AI 호출이 규칙 기반으로 바뀐다
# AI_GENERATION_DAILY_LIMIT=30
# AI_MONTHLY_BUDGET_USD=30

# DB: sqlite(기본, 로컬) | postgres(직접 연결) | data-api(Aurora Data API — Lambda 권장)
DB_DRIVER=sqlite
# sqlite: 파일 위치 (기본 ./data/app.db)
# DATABASE_PATH=
# postgres: 접속 주소
# DATABASE_URL=postgres://codereading:<암호>@<호스트>:5432/jobase
# data-api: 클러스터 ARN, Secrets Manager 비밀 ARN, 데이터베이스 이름
# DB_CLUSTER_ARN=arn:aws:rds:ap-northeast-2:<계정>:cluster:codereading-db
# DB_SECRET_ARN=arn:aws:secretsmanager:ap-northeast-2:<계정>:secret:<이름>
# DB_NAME=jobase

# 관리자 화면(/admin) 토큰. 설정하지 않으면 로컬에서만 접근 가능
# ADMIN_TOKEN=
# 화면 주소(CORS). 쉼표로 여러 개. 비워 두면 어디서든 허용 (로컬용)
# ALLOWED_ORIGINS=https://<아이디>.github.io,http://localhost:3000
# EC2 (docker compose): Caddy 가 HTTPS 인증서를 받을 주소. 예) 43-201-12-34.sslip.io (공인 IP 의 . 을 - 로)
# SITE_ADDRESS=
# 로그인 없이 쓰는 동안의 학습 기록 보관 시간 (마지막 사용 후 N시간이 지나면 삭제)
# SESSION_TTL_HOURS=12

# ─────────────────────────────────────────────────────────────
# 화면 (npm run dev / 정적 빌드) 설정 — 로컬은 .env.local 에 넣는다
# ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8787
# NEXT_PUBLIC_BASE_PATH=
