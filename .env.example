# ─────────────────────────────────────────────────────────────
# API (Lambda / 로컬: npm run api) 설정 — 로컬은 이 파일을 .env 로 복사
# Lambda 에서는 같은 이름으로 '환경 변수'에 넣는다 (비밀 값은 GitHub 에 올리지 않기)
# ─────────────────────────────────────────────────────────────

# AI 동작 모드: live(실제 Claude) | mock(흉내 낸 AI 응답, UI/UX 확인용) | off(AI 없이 규칙 채점·저장된 해설만)
AI_MODE=mock
# AI 제공처: anthropic(Claude API, 기본) | bedrock(AWS Bedrock 직접, 키) | relay(Bedrock 중계 Lambda — 학교 계정 EC2)
#          | converse(API 가 Lambda 에서 돌 때 실행 역할로 Bedrock Converse 직접 호출 — docs/DEPLOY_LAMBDA.md)
# converse: 모델·리전 (기본값: us.anthropic.claude-haiku-4-5-20251001-v1:0, us-east-1)
# BEDROCK_MODEL_ID=
# BEDROCK_REGION=
# AI_PROVIDER=anthropic
# relay: Lambda 함수 URL 과 중계 토큰 (Lambda 환경 변수 RELAY_TOKEN 과 같은 값) — docs/DEPLOY_AWS.md 8단계
# AI_RELAY_URL=
# AI_RELAY_TOKEN=
# anthropic: Claude API 키 (live 모드)
ANTHROPIC_API_KEY=
# bedrock: 리전과 IAM 사용자 액세스 키 (EC2 의 .env 에만 넣기 — GitHub·채팅에 올리지 않기)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# 작업 난이도별 모델 (비용 관리). 비워 두면 anthropic: claude-haiku-5-5 / claude-opus-5-5, bedrock: 둘 다 anthropic.claude-haiku-4-5
# (relay 는 Lambda 코드의 MODEL_ID 를 씀)
# CLAUDE_MODEL_FAST=
# CLAUDE_MODEL_SMART=
# 하루 최대 AI 콘텐츠 생성 횟수, 월 예산(USD) — 예산을 넘으면 모든 AI 호출이 규칙 기반으로 바뀐다
# AI_GENERATION_DAILY_LIMIT=30
# AI_MONTHLY_BUDGET_USD=10

# DB: sqlite(기본, 로컬) | postgres(직접 연결) | data-api(Aurora Data API) | dynamodb(Lambda + DynamoDB — docs/DEPLOY_LAMBDA.md)
DB_DRIVER=sqlite
# sqlite: 파일 위치 (기본 ./data/app.db)
# DATABASE_PATH=
# postgres: 접속 주소
# DATABASE_URL=postgres://codereading:<암호>@<호스트>:5432/jobase
# data-api: 클러스터 ARN, Secrets Manager 비밀 ARN, 데이터베이스 이름
# DB_CLUSTER_ARN=arn:aws:rds:ap-northeast-2:<계정>:cluster:codereading-db
# DB_SECRET_ARN=arn:aws:secretsmanager:ap-northeast-2:<계정>:secret:<이름>
# DB_NAME=jobase
# dynamodb: 테이블 이름 (파티션 키 pk, 정렬 키 sk, TTL 속성 ttl). 로컬 테스트는 DYNAMODB_ENDPOINT 로 흉내 서버 지정
# DYNAMODB_TABLE=codereading
# 테이블 TTL 속성 이름이 ttl 이 아니면 (예: jojo_ttl)
# DYNAMODB_TTL_ATTR=

# 관리자 화면(/admin) 토큰. 설정하지 않으면 로컬에서만 접근 가능
# ADMIN_TOKEN=
# 화면 주소(CORS). 쉼표로 여러 개. 비워 두면 어디서든 허용 (로컬용)
# ALLOWED_ORIGINS=https://<아이디>.github.io,http://localhost:3000
# EC2 (docker compose): Caddy 가 HTTPS 인증서를 받을 주소. 예) 43-201-12-34.sslip.io (공인 IP 의 . 을 - 로)
# SITE_ADDRESS=
# EC2: IP 가 바뀌어도 같은 주소를 쓰려면 DuckDNS (scripts/ec2/install-dns.sh). 이때 SITE_ADDRESS=<이름>.duckdns.org
# DUCKDNS_DOMAIN=
# DUCKDNS_TOKEN=
# 요청 수 제한 (0 이면 끔). 교실처럼 여러 명이 같은 IP 를 쓰는 경우를 고려한 기본값
# RATE_LIMIT_PER_MINUTE=600              # IP 하나의 1분 전체 요청
# RATE_LIMIT_AI_PER_SESSION_HOUR=30      # 학습자 1명의 1시간 AI 요청 (튜터 질문·AI 분석·주관식 AI 채점)
# RATE_LIMIT_AI_PER_IP_HOUR=300          # IP 하나의 1시간 AI 요청
# RATE_LIMIT_NEW_SESSIONS_PER_HOUR=120   # IP 하나가 1시간에 새로 만드는 학습자 수
# MAX_BODY_KB=256                        # 요청 본문 최대 크기
# 로그인 없이 쓰는 동안의 학습 기록 보관 시간 (마지막 사용 후 N시간이 지나면 삭제)
# SESSION_TTL_HOURS=12

# ─────────────────────────────────────────────────────────────
# 화면 (npm run dev / 정적 빌드) 설정 — 로컬은 .env.local 에 넣는다
# ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8787
# NEXT_PUBLIC_BASE_PATH=
