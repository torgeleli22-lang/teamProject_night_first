# ─────────────────────────────────────────────────────────────
# 내 컴퓨터에서 실행할 때 (npm run api) 쓰는 설정 — 이 파일을 .env 로 복사해서 고친다
# AWS 에서는 같은 이름을 각 Lambda 의 '구성 → 환경 변수'에 넣는다 (docs/DEPLOY_LAMBDA.md)
# 비밀 값(관리자 복구 코드 등)은 GitHub·채팅에 올리지 않는다
# ─────────────────────────────────────────────────────────────

# AI 동작: mock(흉내 낸 응답, 비용 없음 — 로컬 기본값) | live(Bedrock 실제 호출) | off(AI 없이 규칙 채점·저장된 해설만)
AI_MODE=mock
# 목업 응답을 기다리는 시간(초). 화면의 '생각 중' 표시를 확인할 때만 늘린다
# MOCK_DELAY_SEC=0.8

# ── 아래는 AWS Lambda 환경 변수 (로컬에서는 기본값으로 충분) ──
# TABLE_NAME=jojo_table                 # DynamoDB 테이블 (파티션 키 pk, 정렬 키 sk)
# TTL_ATTR=jojo_ttl                     # 테이블의 TTL(자동 삭제) 속성 이름
# MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_REGION=us-east-1
# ALLOWED_ORIGINS=https://<아이디>.github.io   # 화면 주소 (CORS). 비워 두면 어디서든 허용
# ADMIN_TOKEN=                          # 관리자 복구 코드 (admin Lambda 에만, 직접 정한 값)
# AI_MONTHLY_BUDGET_USD=10              # 한 달 AI 예산 — 넘을 수 있는 호출은 하지 않고 규칙 기반으로
# AI_GENERATION_DAILY_LIMIT=30          # 하루 AI 문제 생성 상한
# GENERATE_CODE_FUNCTION=jojo_generate_code        # 다른 Lambda 이름 (콘솔에서 만든 이름과 같게)
# GENERATE_THEORY_FUNCTION=jojo_generate_theory
# LEARNER_ANALYSIS_FUNCTION=jojo_learner_analysis
# 요청 수 제한 (0 이면 끔). 교실처럼 여러 명이 같은 IP 를 쓰는 경우를 고려한 기본값
# RATE_LIMIT_PER_MINUTE=600
# RATE_LIMIT_AI_PER_SESSION_HOUR=30
# RATE_LIMIT_AI_PER_IP_HOUR=300
# RATE_LIMIT_AI_TOTAL_HOUR=400
# RATE_LIMIT_NEW_SESSIONS_PER_HOUR=120

# ─────────────────────────────────────────────────────────────
# 화면 (npm run dev / 정적 빌드) — 로컬은 .env.local 에 넣는다
# ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8787
# NEXT_PUBLIC_BASE_PATH=
