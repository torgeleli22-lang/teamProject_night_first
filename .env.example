# Claude API 키. 비워두면 AI 없이 동작합니다 (규칙 채점 + 미리 저장된 힌트·해설 + 규칙 기반 학습 분석).
ANTHROPIC_API_KEY=

# 작업 난이도별 모델 (비용 관리). 간단한 작업은 fast, 높은 추론이 필요한 작업은 smart.
# CLAUDE_MODEL_FAST=claude-haiku-5-5
# CLAUDE_MODEL_SMART=claude-opus-5-5

# 하루 최대 AI 콘텐츠 생성 횟수 (비용 상한)
# AI_GENERATION_DAILY_LIMIT=30

# 관리자 화면(/admin) 토큰. 설정하지 않으면 개발 모드에서만 접근 가능
# ADMIN_TOKEN=

# SQLite 파일 위치 (기본: ./data/app.db)
# DATABASE_PATH=
