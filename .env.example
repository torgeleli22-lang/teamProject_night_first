# AI 동작 모드: live(실제 Claude) | mock(흉내 낸 AI 응답, UI/UX 확인용) | off(AI 없이 규칙 채점·저장된 해설만)
# 지정하지 않으면 API 키가 있으면 live, 없으면 off
AI_MODE=mock

# Claude API 키 (live 모드)
ANTHROPIC_API_KEY=

# 작업 난이도별 모델 (비용 관리). 간단한 작업은 fast, 높은 추론이 필요한 작업은 smart.
# CLAUDE_MODEL_FAST=claude-haiku-5-5
# CLAUDE_MODEL_SMART=claude-opus-5-5

# 하루 최대 AI 콘텐츠 생성 횟수, 월 예산(USD) — 생성 기준은 docs/ai-generation-policy.md
# AI_GENERATION_DAILY_LIMIT=30
# AI_MONTHLY_BUDGET_USD=30

# 관리자 화면(/admin) 토큰. 설정하지 않으면 개발 모드에서만 접근 가능
# ADMIN_TOKEN=

# SQLite 파일 위치 (기본: ./data/app.db)
# DATABASE_PATH=

# 로그인 없이 쓰는 동안의 학습 기록 보관 시간 (마지막 사용 후 N시간이 지나면 세션과 기록을 삭제)
# 세션 쿠키는 브라우저를 닫으면 사라지므로, 다시 접속하면 새로 시작한다
# SESSION_TTL_HOURS=12
